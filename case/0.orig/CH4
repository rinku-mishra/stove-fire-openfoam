FoamFile { version 2.0; format ascii; class volScalarField; object CH4; }
#include "$FOAM_CASE/system/caseParams"
dimensions [0 0 0 0 0 0 0];
internalField uniform 0;
boundaryField
{
    "(walls|steel|baffle|collar|glass|sideGlass.*|logs)" { type zeroGradient; }
    "(airwash|primary|tertiary)" { type fixedValue; value uniform 0; }
    fuel { type totalFlowRateAdvectiveDiffusive; massFluxFraction $Y_fuel_CH4; phi phi; rho rho; value uniform $Y_fuel_CH4; }
    flue { type inletOutlet; inletValue uniform 0; value uniform 0; }
}
