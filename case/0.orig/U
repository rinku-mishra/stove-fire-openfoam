FoamFile { version 2.0; format ascii; class volVectorField; object U; }
#include "$FOAM_CASE/system/caseParams"
dimensions [0 1 -1 0 0 0 0];
internalField uniform (0 0 0);
boundaryField
{
    "(walls|steel|baffle|collar|glass|sideGlass.*|logs)" { type noSlip; }
    fuel { type flowRateInletVelocity; massFlowRate $fuelMassFlow; rhoInlet 0.35; value uniform (0 0 0); }
    airwash  { type flowRateInletVelocity; massFlowRate $mAirwash;  rhoInlet 1.205; value uniform (0 0 0); }
    primary  { type flowRateInletVelocity; massFlowRate $mPrimary;  rhoInlet 1.205; value uniform (0 0 0); }
    tertiary { type flowRateInletVelocity; massFlowRate $mTertiary; rhoInlet 1.205; value uniform (0 0 0); }
    flue { type pressureInletOutletVelocity; value uniform (0 0 0); }
}
