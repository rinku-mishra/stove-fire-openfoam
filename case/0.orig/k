FoamFile { version 2.0; format ascii; class volScalarField; object k; }
#include "$FOAM_CASE/system/caseParams"
dimensions [0 2 -2 0 0 0 0];
internalField uniform 1e-5;
boundaryField
{
    ".*" { type zeroGradient; }
    "(airwash|primary|tertiary|fuel)" { type fixedValue; value $internalField; }
    flue { type inletOutlet; inletValue $internalField; value $internalField; }
}
