FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     fireFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         25;             // results are averaged over 15-25 s
deltaT          1e-4;
adjustTimeStep  yes;
maxCo           0.6;
maxDeltaT       0.01;
writeControl    adjustable;
writeInterval   0.5;            // 0.1 for smooth animations (~2 GB per core)
purgeWrite      0;
writeFormat     binary;
writePrecision  7;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

functions
{
    HRR         // total heat release rate of the flame [W]
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       volIntegrate;
        fields          (Qdot);
        writeFields     no;
        writeControl    timeStep;
        writeInterval   20;
    }
    peakT
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        regionType      all;
        operation       max;
        fields          (T);
        writeFields     no;
        writeControl    timeStep;
        writeInterval   20;
    }
    flueGas
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            flue;
        operation       weightedAverage;
        weightField     phi;
        fields          (T O2 CH4 CO2 H2O);
        writeFields     no;
        writeControl    timeStep;
        writeInterval   20;
    }
    surfaceHeat
    {
        type            wallHeatFlux;
        libs            (fieldFunctionObjects);
        patches         (glass sideGlassL sideGlassR walls steel collar baffle logs fuel);
        qr              qr;
        executeControl  timeStep;
        executeInterval 20;
        writeControl    writeTime;
    }

    // Terms wallHeatFlux cannot see, needed to close the energy balance:
    // enthalpy carried through every opening (sum of phi*h; inflow counts negative) and
    // radiation leaving through the openings and into the gas-releasing log faces
    // ('fuel' is a non-wall patch, which wallHeatFlux skips).
    hFlue
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            flue;
        operation       weightedSum;
        weightField     phi;
        fields          (h);
        writeFields     no;
        writeControl    timeStep;
        writeInterval   20;
    }
    hAirwash  { $hFlue; name airwash; }
    hPrimary  { $hFlue; name primary; }
    hTertiary { $hFlue; name tertiary; }
    hFuel     { $hFlue; name fuel; }
    qrFlue
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            flue;
        operation       areaIntegrate;
        fields          (qr);
        writeFields     no;
        writeControl    timeStep;
        writeInterval   20;
    }
    qrAirwash  { $qrFlue; name airwash; }
    qrPrimary  { $qrFlue; name primary; }
    qrTertiary { $qrFlue; name tertiary; }
    qrFuel     { $qrFlue; name fuel; }

    slices
    {
        type            surfaces;
        libs            (sampling);
        writeControl    adjustable;
        writeInterval   0.1;
        surfaceFormat   vtk;
        formatOptions   { vtk { format binary; legacy false; } }
        fields          (T U Qdot CH4 O2);
        interpolationScheme cellPoint;
        surfaces
        {
            sideCut  { type cuttingPlane; planeType pointAndNormal;
                       pointAndNormalDict { point (0 0 0); normal (1 0 0); }
                       interpolate true; }
            frontCut { type cuttingPlane; planeType pointAndNormal;
                       pointAndNormalDict { point (0 0.125 0); normal (0 1 0); }
                       interpolate true; }
        }
    }
}

