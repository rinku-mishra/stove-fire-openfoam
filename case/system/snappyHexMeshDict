FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    miro3.stl
    {
        type triSurfaceMesh;
        name miro3;
        regions
        {
            walls    { name walls; }
            collar   { name collar; }
            flue     { name flue; }
            baffle   { name baffle; }
            logs     { name logs; }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells       1000000;
    maxGlobalCells      2000000;
    minRefinementCells  0;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 2;
    features ( { file "miro3.eMesh"; level 0; } );
    refinementSurfaces
    {
        miro3
        {
            level (0 0);
            regions
            {
                walls    { level (0 0); patchInfo { type wall; } }
                collar   { level (0 0); patchInfo { type wall; } }
                flue     { level (0 0); patchInfo { type patch; } }
                baffle   { level (0 0); patchInfo { type wall; } }
                logs     { level (0 0); patchInfo { type wall; } }    // split into fuel / char by topoSet
            }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions {}
    locationInMesh (0.0 0.12 0.33);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      100;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes true; layers {}; expansionRatio 1.0; finalLayerThickness 0.3;
    minThickness 0.1; nGrow 0; featureAngle 60; nRelaxIter 3; nSmoothSurfaceNormals 1;
    nSmoothNormals 3; nSmoothThickness 10; maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3; minMedialAxisAngle 90; nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minVol 1e-13;
    minTetQuality 1e-15;
    minArea -1;
    minTwist 0.02;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;

