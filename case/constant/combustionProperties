FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      combustionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Eddy dissipation: burning rate set by turbulent mixing of fuel and air,
// which is the controlling process in wood-stove flames.
combustionModel EDM;
EDMCoeffs { semiImplicit no; Cd 1; CEDC 1; }
active          on;

