FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  LES;
LES
{
    LESModel        kEqn;
    delta           cubeRootVol;
    turbulence      on;
    printCoeffs     on;
    kEqnCoeffs      { ck 0.07; }
    cubeRootVolCoeffs { deltaCoeff 1; }
}

